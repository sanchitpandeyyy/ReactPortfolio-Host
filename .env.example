# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Password for /admin. Server-only.
ADMIN_PASSWORD=

# ─── Cloudinary (admin image uploads) ────────────────────────────────────────
CLOUDINARY_URL=

# ─── Central blog (blog.sanchit.pro) ─────────────────────────────────────────
# Read-only API that serves published articles with showOnPortfolios = true.
# Both portfolios consume this same endpoint.
BLOG_API_URL=https://blog.sanchit.pro/api/v1

# Shared secret for POST /api/revalidate-blog. Must be identical to
# PORTFOLIO_WEBHOOK_SECRET on the blog. Server-only: never expose it.
BLOG_WEBHOOK_SECRET=

# ─── This site ───────────────────────────────────────────────────────────────
# Absolute origin used for canonical URLs, the sitemap and JSON-LD.
SITE_URL=https://sanchitpandey.com.np
